{
  "name": "playwright_ts_orangehrm",
  "version": "1.0.0",
  "description": "Enterprise Playwright TypeScript Automation Framework for OrangeHRM",
  "author": "Rohit",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "smoke": "playwright test tests/smoke",
    "sanity": "playwright test tests/sanity",
    "regression": "playwright test tests/regression",
    "e2e": "playwright test tests/e2e",
    "api": "playwright test tests/api",
    "headed": "playwright test --headed",
    "debug": "playwright test --debug",
    "ui": "playwright test --ui",
    "chrome": "playwright test --project=chromium",
    "firefox": "playwright test --project=firefox",
    "edge": "playwright test --project=Microsoft Edge",
    "webkit": "playwright test --project=webkit",
    "parallel": "playwright test --workers=100%",
    "serial": "playwright test --workers=1",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "rimraf test-results playwright-report allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "npm run allure:generate && npm run allure:open",
    "test:ci": "cross-env CI=true playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
